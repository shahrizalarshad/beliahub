# Belia Hub — local Docker defaults (copy to .env after Laravel scaffold)
APP_NAME="Belia Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Kuala_Lumpur

APP_PORT=8080
VITE_PORT=5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=beliahub
DB_USERNAME=beliahub
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@beliahub.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Landing hero — put file at public/images/hero.jpg, or set a full URL
LANDING_HERO_IMAGE=images/hero.png
LANDING_HERO_OVERLAY=0.55

# Production-only (Cloudflare R2) — leave empty for local dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

ORG_BANK_NAME=
ORG_BANK_ACCOUNT_NO=
ORG_BANK_ACCOUNT_NAME=
