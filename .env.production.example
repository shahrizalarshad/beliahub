# =============================================================================
# Belia Hub — Production Environment (Vercel + Aiven + R2 + Brevo)
# =============================================================================
# Salin nilai ini ke Vercel → Project Settings → Environment Variables.
# Jangan commit fail ini dengan nilai sebenar.

APP_NAME="Belia Hub"
APP_ENV=production
APP_KEY=                         # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://your-domain.vercel.app
APP_TIMEZONE=Asia/Kuala_Lumpur

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database (Aiven MySQL) ---
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=database/certs/aiven-ca.pem   # Laluan relatif fail CA Aiven (bukan kandungan PEM)

# --- Session & Cache (serverless-safe) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

# --- File Storage (Cloudflare R2 via S3 API) ---
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Email (Brevo SMTP) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Organization bank details (shown to clients) ---
ORG_BANK_NAME=
ORG_BANK_ACCOUNT_NO=
ORG_BANK_ACCOUNT_NAME=

# --- Landing page ---
LANDING_HERO_IMAGE=images/hero.png
LANDING_HERO_OVERLAY=0.55

# --- Vite ---
VITE_APP_NAME="${APP_NAME}"

# --- Superadmin (first deploy seed) ---
SUPERADMIN_EMAIL=
SUPERADMIN_NAME="Pentadbir Belia Hub"
SUPERADMIN_PASSWORD=             # Guna kata laluan kuat; jangan commit nilai sebenar

# --- Vercel runtime cache paths (auto-set in vercel.json, listed for reference) ---
# APP_CONFIG_CACHE=/tmp/config.php
# VIEW_COMPILED_PATH=/tmp/views
# LOG_CHANNEL=stderr
